  allYearData:
  - yearIdentifier: R7
    questionImages:
    - {fileID: 21300000, guid: 5f7c8e59873446345b086d54bb7bd1a4, type: 3}
    - {fileID: 21300000, guid: 68683fd109a3cee45bb05b30b5336b2f, type: 3}
    questionAnswers:
    - 24
    - 123
    questionText: "\u56F31\u306B\u793A\u3057\u305F\u7ACB\u4F53ABCD-EFGH\u306F\u3001AB=AD=6\u339D\u3001AE=4\u339D\u306E\u76F4\u65B9\u4F53\u3067\u3042\u308B\u3002
      \u9802\u70B9A\u3068\u9802\u70B9C\u3092\u7D50\u3073\u3001\u7DDA\u5206AC\u4E0A\u306B\u3042\u308B\u70B9\u3092P\u3068\u3059\u308B\u3002\u9802\u70B9H\u3068\u70B9P\u3092\u7D50\u3076\u3002
      \u6B21\u306E\u5404\u554F\u306B\u7B54\u3048\u3088\u3002   [\u554F1] \u6B21\u306E\u3010
      (1) \u3011\u306B\u5F53\u3066\u306F\u307E\u308B\u6570\u5B57\u3092\u7B54\u3048\u3088\u3002
      \u56F31\u306B\u304A\u3044\u3066\u3001\u9802\u70B9D\u3068\u70B9P\u3001\u9802\u70B9E\u3068\u70B9P\u3092\u305D\u308C\u305E\u308C\u7D50\u3093\u3060\u5834\u5408\u3092\u8003\u3048\u308B\u3002
      \u70B9P\u304C\u7DDA\u5206AC\u306E\u4E2D\u70B9\u306E\u3068\u304D\u3001\u7ACB\u4F53P-AEHD\u306E\u4F53\u7A4D\u306F\u3001\u3010
      (1) \u3011\u33A4\u3067\u3042\u308B\u3002  [\u554F2] \u6B21\u306E\u3010 (2)
      \u3011\u306B\u5F53\u3066\u306F\u307E\u308B\u6570\u5B57\u3092\u7B54\u3048\u3088\u3002
      \u56F32\u306F\u3001\u56F31\u306B\u304A\u3044\u3066\u3001\u9802\u70B9\uFF26\u3068\u9802\u70B9\uFF28\u3001\u9802\u70B9\uFF26\u3068\u70B9\uFF30\u3092\u305D\u308C\u305E\u308C\u7D50\u3093\u3060\u5834\u5408\u3092\u8868\u3057\u3066\u3044\u308B\u3002\u25B3FPH\u306E\u9762\u7A4D\u306F\u3001\u3010
      (2) \u3011\u221A\u3010 (2) \u3011\u33A0\u3067\u3042\u308B\u3002  \u203B\u3010
      (2) \u3011\u221A\u3010 (2) \u3011\u3067\u7B54\u3048\u304C16\u221A3\u306A\u3069\u306E\u5834\u5408\u3001\u56DE\u7B54\u6B04\u306B\u306F\u300C163\u300D\u3068\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002 "
    ansertext: "R7 - 5 - (1)  S1\u3000\u56DB\u89D2\u9310P-AEHD\u306B\u304A\u3044\u3066\u3001\u5E95\u9762AEHD
      = 6 * 4 = 24 ... \u2460 (R7_1.JPG)  S2\u3000\u9802\u70B9P\u304B\u3089\u8FBAAD\u306B\u5782\u7DDA\u3092\u5F15\u304F\u3002\u4EA4\u70B9\u3092Q\u3068\u3059\u308B\u3002PQ\u3092\u56DB\u89D2\u9310P-AEHD\u306E\u9AD8\u3055\u3068\u3059\u308B\u3002(R7_2.JPG) 
      S3\u3000\u56DB\u89D2\u5F62ABCD\u3067\u8003\u3048\u308B\u3002\u6B63\u65B9\u5F62\u306E\u5BFE\u89D2\u7DDA\u306F\u4E2D\u70B9\u3067\u4EA4\u308F\u308B\u3002\u70B9P\u306F\u5BFE\u89D2\u7DDADB\u306E\u4E2D\u70B9\u3067\u3082\u3042\u308B\u3002\u3088\u3063\u3066\u3001\u6C34\u5E73\u65B9\u5411\u3067\u8003\u3048\u308C\u3070\u3001\u5404\u8FBA\u3082\uFF12\u7B49\u5206\u3059\u308B\u3002PQ\u306F\u8FBAAB\u306E\u534A\u5206\u3067\u3042\u308B\u304B\u3089
      PQ = 3 ... \u2461\u3000(R7_3.mp4) \u3000\u3000\u56DB\u89D2\u9310\u306E\u516C\u5F0F
      (\u5E95\u9762\u7A4D * \u9AD8\u3055 * 1/3) \u3068\u2460\u3068\u2461\u3088\u308A\u3001P-AEHD
      = 24 * 3 * 1/3 = 24 ... \u7B54\u3048 (3D)   -------------------------------------------------------------------------------------------------------------------- 
      R7 - 5 - (2)  S1\u3000\u4E09\u89D2\u5F62PHF\u306E\u9762\u7A4D\u3092\u6C42\u3081\u3066\u3044\u304F\u3002\u516C\u5F0F\u306F
      (\u5E95\u8FBA * \u9AD8\u3055 * 1/2) \u3002 \u3000\u3000\u307E\u305A\u306F\u5E95\u8FBAHF\u306E\u9577\u3055\u3092\u6C42\u3081\u3066\u3044\u304F\u3002
      \u3000\u3000\u56DB\u89D2\u5F62EFGH\u306E\u5BFE\u89D2\u7DDA\u306A\u306E\u3067\u3001\u534A\u5206\u306E\u76F4\u89D2\u4E09\u89D2\u5F62EFH
      (\u4E09\u89D2\u5F62FGH\u3067\u3082\u3088\u3044) \u3067 \u4E09\u5E73\u65B9\u306E\u5B9A\u7406\u3092\u4F7F\u3063\u3066\u3001\u659C\u8FBA
      (\u5BFE\u89D2\u7DDAHF)\u306E\u9577\u3055\u3092\u6C42\u3081\u3066\u3044\u304F\u3002\u4E09\u5E73\u65B9\u306E\u5B9A\u7406\u306E\u516C\u5F0F\u306F
      (\u659C\u8FBA^2 = 1\u8FBA^2 + 1\u8FBA^2) \u3002(R7_4.JPG) \u3000\u3000\u5BFE\u89D2\u7DDAHF
      = 6^2 + 6^2 = 72, \u221A72 = 6\u221A2 ... \u2460 (R7_5.JPG)  S2\u3000\u6B21\u306B\u9AD8\u3055\u3092\u6C42\u3081\u3066\u3044\u304F\u3002
      \u3000\u3000\u4E09\u89D2\u5F62PHF\u306B\u304A\u3044\u3066\u3001P\u304B\u3089\u8FBAHF\u306B\u5782\u7DDA\u3092\u5F15\u304F\u3002\u8FBAHF\u3068\u5782\u7DDA\u306E\u4EA4\u70B9\u3092R\u3068\u3059\u308B\u3002\u305D\u306E\u70B9\u306F\u5BFE\u89D2\u7DDAEG\u4E0A\u306B\u3042\u308B\u3053\u3068\u304C\u5206\u304B\u308B\u3002\u305D\u306E\u7DDA\u5206PR\u304C\u9AD8\u3055\u3068\u306A\u308B\u3002(3D)
      \u3000\u3000\u9802\u70B9A\u3068\u9802\u70B9C\u3001\u9802\u70B9E\u3068\u9802\u70B9G\u3092\u7D50\u3073\u3001\u9577\u65B9\u5F62AEGC\u3092\u4F5C\u308B\u3002(3D) 
      S3\u3000\u9577\u65B9\u5F62AEGC\u306B\u304A\u3044\u3066\u3001\u70B9R\u304B\u3089\u8FBAAC\u306B\u5782\u7DDA\u3092\u5F15\u304F\u3002\u305D\u306E\u4EA4\u70B9\u3092\u70B9S\u3068\u3059\u308B\u3002\u70B9S\u3068\u70B9R\u3068\u70B9P\u3092\u7D50\u3073\u3001\u4E09\u89D2\u5F62\u3092\u4F5C\u308B\u3002\u659C\u8FBA\u3067\u3042\u308B\u8FBAPR\u3092\u6C42\u3081\u308B\u3053\u3068\u304C\u76EE\u6A19\u3067\u3042\u308B\u3002
      \u3000\u3000\u8FBASP\u306E\u9577\u3055\u3092\u6C42\u3081\u3066\u3044\u304F\u3002AP\uFF1APC
      = 5\uFF1A1 \u307E\u305F  AC = 6\u221A2 (\u2460\u3068\u540C\u3058\u304F\u5BFE\u89D2\u7DDA\u3067\u3042\u308B\u304B\u3089)
      \u3088\u308A\u3001PC\u306F1/6\u3060\u304B\u3089 PC = \u221A2 \u3002\u307E\u305F\u3001\u5BFE\u89D2\u7DDA\u306E\u534A\u5206\u3088\u308A\u3001SC
      = 3\u221A2 \u3002SP = SC - PC = 3\u221A2 - 2\u221A2 \u3000\u3000\u4E09\u89D2\u5F62PRS\u306B\u304A\u3044\u3066\u3001\u4E09\u5E73\u65B9\u306E\u5B9A\u7406\u3092\u4F7F\u3063\u3066\u659C\u8FBAPR\u3092\u6C42\u3081\u308B\u3002
      \u3000\u3000\u659C\u8FBAPR = 4^2 + (2\u221A2)^2 = 24, \u221A24 = 2\u221A6 ...
      \u2461 \u3000\u3000\u3053\u308C\u304C\u4E09\u89D2\u5F62PHF\u306E\u9AD8\u3055\u3068\u306A\u308B\u3002(R7_6.JPG)
      \u3000\u3000\u3088\u3063\u3066\u3001\u2460\u3068\u2461\u3088\u308A\u3001\u4E09\u89D2\u5F62PHF\u306E\u9762\u7A4D
      = 6\u221A2 * 2\u221A6 * 1/2 = 6\u221A12 = 12\u221A3 ...\u7B54\u3048 (R7_7.JPG)"
